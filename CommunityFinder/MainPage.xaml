<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="onePA Courses"
             x:Class="CommunityFinder.MainPage"
             BackgroundColor="#F9FFE3">


    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E9FFD6" Offset="0.0"/>
            <GradientStop Color="#DFF8B9" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- 输入控件统一外观（注意：Entry/Picker 无 CornerRadius，所以不设置） -->
            <Style TargetType="Entry">
                <Setter Property="HeightRequest" Value="40"/>
                <Setter Property="BackgroundColor" Value="White"/>
            </Style>
            <Style TargetType="Picker">
                <Setter Property="HeightRequest" Value="40"/>
                <Setter Property="BackgroundColor" Value="White"/>
                <Setter Property="TitleColor" Value="#7A7A7A"/>
                <Setter Property="HorizontalOptions" Value="FillAndExpand"/>
            </Style>

            <!-- Register 按钮（用 DataTrigger 切换状态） -->
            <Style x:Key="RegisterButtonStyle" TargetType="Button">
                <Setter Property="Text" Value="Register"/>
                <Setter Property="BackgroundColor" Value="#5DBB63"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="CornerRadius" Value="22"/>
                <Setter Property="Padding" Value="20,8"/>
                <Setter Property="HorizontalOptions" Value="End"/>
                <!--<Style.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding HasVacancy}" Value="False">
                        <Setter Property="Text" Value="Registration Closed"/>
                        <Setter Property="BackgroundColor" Value="#9E9E9E"/>
                    </DataTrigger>
                </Style.Triggers> -->
            </Style>

            <!-- 顶部菜单样式 -->
            <Style x:Key="TopTab" TargetType="Label">
                <Setter Property="VerticalOptions" Value="Center"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="TextColor" Value="#2A2A2A"/>
            </Style>
            <Style x:Key="TopTabActive" BasedOn="{StaticResource TopTab}" TargetType="Label">
                <Setter Property="TextColor" Value="#F05A5A"/>
                <Setter Property="FontAttributes" Value="Bold"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="12">

        <!-- 顶部导航 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="8" BackgroundColor="#FFFFFFAA" Margin="0,0,0,8"
          HeightRequest="56">
            <!-- 左：Logo 占位 -->
            <Frame CornerRadius="24" HeightRequest="40" WidthRequest="40" Padding="0" HasShadow="False" VerticalOptions="Center">
                <BoxView Color="#FFE7C4"/>
            </Frame>

            <!-- 中：Tabs -->
            <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="18" HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="About Us" Style="{StaticResource TopTab}"/>
                <Label Grid.Column="1" Text="Events" Style="{StaticResource TopTab}"/>
                <Label Grid.Column="2" Text="Courses" Style="{StaticResource TopTabActive}"/>
                <Label Grid.Column="3" Text="Forum" Style="{StaticResource TopTab}"/>
            </Grid>

            <!-- 右：设置图标占位 -->
            <Frame Grid.Column="2" CornerRadius="18" HeightRequest="36" WidthRequest="36" Padding="0" HasShadow="False" VerticalOptions="Center">
                <Button Grid.Column="10" Text="" WidthRequest="44" HeightRequest="40" CornerRadius="20"
                Clicked="OnSettingClicked"/>
            </Frame>
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" ColumnDefinitions="*" Margin="0,0,0,10">

            <!-- 第1行：L1/L2/L3 + 搜索 -->
            <HorizontalStackLayout Grid.Row="0" Spacing="12" Margin="0,0,0,0">
                <!-- L1 -->
                <VerticalStackLayout WidthRequest="180" Spacing="4">
                    <Label Text="What" />
                    <Picker ItemsSource="{Binding L1Options}"
            SelectedItem="{Binding SelectedL1}"
            Title="Select a category"/>
                </VerticalStackLayout>

                <!-- L2 -->
                <VerticalStackLayout WidthRequest="200" Spacing="4"
                       IsVisible="{Binding HasL1Selected}" Opacity="0" x:Name="L2Panel">
                    <Label Text="Category" />
                    <Picker ItemsSource="{Binding L2Options}"
            SelectedItem="{Binding SelectedL2}"
            Title="Select a subcategory"/>
                </VerticalStackLayout>

                <!-- L3 -->
                <VerticalStackLayout WidthRequest="220" Spacing="4"
                       IsVisible="{Binding HasL2Selected}" Opacity="0" x:Name="L3Panel">
                    <Label Text="Topic" />
                    <Picker ItemsSource="{Binding L3Options}"
            SelectedItem="{Binding SelectedL3}"
            Title="Select a topic"/>
                </VerticalStackLayout>

                <!-- 搜索框 + 放大镜 -->
                <Entry Grid.Column="9" Placeholder="Search title..." Text="{Binding SearchText}" />
                <Button Grid.Column="10" Text="🔍" WidthRequest="44" HeightRequest="40" CornerRadius="20"
            Clicked="OnSearchClicked"/>
            </HorizontalStackLayout>

            <!-- 第2行：Where / Day / Time -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,160,12,Auto,140,12,Auto,140" ColumnSpacing="0" Margin="0,8,0,0">
                <Label Text="Where" VerticalOptions="Center" Margin="0,0,6,0"/>
                <Picker Grid.Column="1" ItemsSource="{Binding WhereOptions}" SelectedItem="{Binding SelectedWhere}" />

                <Label Grid.Column="3" Text="Day" VerticalOptions="Center" Margin="0,0,6,0"/>
                <Picker Grid.Column="4" ItemsSource="{Binding DayOptions}" SelectedItem="{Binding SelectedDay}" />

                <Label Grid.Column="6" Text="Time" VerticalOptions="Center" Margin="0,0,6,0"/>
                <Picker Grid.Column="7" ItemsSource="{Binding TimeOptions}" SelectedItem="{Binding SelectedTime}" />
            </Grid>
        </Grid>

        <!-- 列表卡片 -->
        <Grid Grid.Row="2" x:Name="ListRegion">

            <CollectionView Grid.Row="2" ItemsSource="{Binding Courses}" SelectionMode="Single" SelectionChanged="OnItemTapped">
                <!-- 空状态（英文） -->
                <CollectionView.EmptyView>
                    <Grid Padding="20">
                        <Label Text="No courses" HorizontalOptions="Center" VerticalOptions="Center" FontSize="16" TextColor="#666"/>
                    </Grid>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <!-- 单条卡片（细边 + 内边距） -->
                        <Grid Padding="12" Margin="0,6" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" BackgroundColor="White">
                            <!-- 右上角：分享 / 收藏（先做占位） -->
                            <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Start" Margin="0,2,0,0">
                                <Label Text="↗" Opacity="0.3" FontSize="16"/>
                                <Label Text="♡" Opacity="0.3" FontSize="16"/>
                            </HorizontalStackLayout>

                            <!-- 左侧主体 -->
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6">

                                <!-- 徽章 COURSE -->
                                <Border StrokeThickness="0" Padding="8,4" StrokeShape="RoundRectangle 8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FFA726" Offset="0"/>
                                            <GradientStop Color="#FFEE58" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="🎓" FontSize="12"/>
                                        <Label Text="COURSE" FontSize="12" FontAttributes="Bold" TextColor="White"/>
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- 标题（紫色可点） -->
                                <Label Text="{Binding Title}"
               TextColor="#6A1B9A" FontAttributes="Bold" FontSize="18"
               LineBreakMode="TailTruncation"/>

                                <!-- Ref Code + By 组织者 -->
                                <Label>
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}Ref Code: {0}    By {1}">
                                            <Binding Path="ClassId"/>
                                            <!-- 课程代码 -->
                                            <Binding Path="OrganizerDisplay"/>
                                            <!-- 见下方模型便捷属性 -->
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>

                                <!-- 组织者链接（橙色） -->
                                <Label Text="{Binding Outlet}" TextColor="#F57C00"/>

                                <!-- 日期与时间行 -->
                                <HorizontalStackLayout Spacing="18" Margin="0,4,0,0">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="📅"/>
                                        <Label>
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}Starts {0:ddd, dd MMM yyyy}">
                                                    <Binding Path="StartDate"/>
                                                    <!-- DateTime? -->
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="⏰"/>
                                        <Label Text="{Binding SessionTime}"/>
                                    </HorizontalStackLayout>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <!-- 右侧价格（垂直居中、加粗） -->
                            <VerticalStackLayout Grid.RowSpan="2" Grid.Column="1" VerticalOptions="Center" Margin="12,0,0,0">
                                <!-- 只显示最低价格 -->
                                <Label FontAttributes="Bold" FontSize="16"
                                    Text="{Binding PriceRangeDisplay}" />
                            </VerticalStackLayout>

                            <!-- 底部分隔线 -->
                            <BoxView Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="1" BackgroundColor="#EEEEEE" Margin="0,12,0,0"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        
            <!--加载动画-->
            <Grid BackgroundColor="#80000000"
        IsVisible="{Binding IsBusy}" InputTransparent="False">
                <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="True" WidthRequest="48" HeightRequest="48"/>
                    <Label Text="Loading..." TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                </StackLayout>
            </Grid>
        </Grid>

        <!-- 底部留白 -->
        <BoxView Grid.Row="3" HeightRequest="8" Opacity="0"/>
    </Grid>
</ContentPage>
