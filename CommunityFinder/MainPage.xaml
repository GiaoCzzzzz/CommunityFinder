<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="onePA Courses"
             x:Class="CommunityFinder.MainPage"
             BackgroundColor="#F9FFE3">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E9FFD6" Offset="0.0"/>
            <GradientStop Color="#DFF8B9" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- 输入控件统一外观 -->
            <Style TargetType="Entry">
                <Setter Property="HeightRequest" Value="40"/>
                <Setter Property="BackgroundColor" Value="White"/>
            </Style>
            <Style TargetType="Picker">
                <Setter Property="HeightRequest" Value="40"/>
                <Setter Property="BackgroundColor" Value="White"/>
                <Setter Property="TitleColor" Value="#7A7A7A"/>
                <Setter Property="HorizontalOptions" Value="FillAndExpand"/>
            </Style>

            <!-- Register 按钮样式 -->
            <Style x:Key="RegisterButtonStyle" TargetType="Button">
                <Setter Property="Text" Value="Register"/>
                <Setter Property="BackgroundColor" Value="#5DBB63"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="CornerRadius" Value="22"/>
                <Setter Property="Padding" Value="20,8"/>
                <Setter Property="HorizontalOptions" Value="End"/>
            </Style>

            <!-- 顶部菜单样式 -->
            <Style x:Key="TopTab" TargetType="Label">
                <Setter Property="VerticalOptions" Value="Center"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="TextColor" Value="#2A2A2A"/>
            </Style>
            <Style x:Key="TopTabActive" BasedOn="{StaticResource TopTab}" TargetType="Label">
                <Setter Property="TextColor" Value="#F05A5A"/>
                <Setter Property="FontAttributes" Value="Bold"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="12">

        <!-- 顶部导航栏 -->
        <Grid Grid.Row="0"
      ColumnDefinitions="Auto,*,Auto"
      Padding="8,0"
      BackgroundColor="#FFFFFF"
      Margin="0,0,0,8"
      HeightRequest="56"
      VerticalOptions="Center"
      HorizontalOptions="FillAndExpand">

            <!-- 左：Logo 图片 -->
            <Frame Grid.Column="0"
           CornerRadius="20"
           HasShadow="False"
           BackgroundColor="Transparent"
           HeightRequest="40"
           WidthRequest="40"
           Padding="0"
           VerticalOptions="Center"
           HorizontalOptions="Start"
           Margin="4,0,0,0">
                <Image Source="icon1.png"
               Aspect="AspectFit"
               HeightRequest="40"
               WidthRequest="40"
               VerticalOptions="Center"
               HorizontalOptions="Center" />
            </Frame>

            <!-- 中：Tabs -->
            <Grid Grid.Column="1"
          ColumnDefinitions="Auto,Auto,Auto,Auto"
          HorizontalOptions="Center"
          VerticalOptions="Center"
          ColumnSpacing="10">
                <!-- 控制标签间距，让它们靠近一点 -->

                <!-- About Us -->
                <Label Grid.Column="0"
               Text="About Us"
               FontSize="13"
               Style="{StaticResource TopTab}"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               Margin="6,0,0,0"/>
                <!-- 略往右移 -->

                <!-- Events -->
                <Label Grid.Column="1"
               Text="Events"
               FontSize="13"
               Style="{StaticResource TopTab}"
               HorizontalOptions="Center"
               VerticalOptions="Center"/>

                <!-- Courses (active tab) -->
                <Label Grid.Column="2"
               Text="Courses"
               FontSize="13"
               Style="{StaticResource TopTabActive}"
               HorizontalOptions="Center"
               VerticalOptions="Center"/>

                <!-- Forum -->
                <Label Grid.Column="3"
               Text="Forum"
               FontSize="13"
               Style="{StaticResource TopTab}"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               Margin="0,0,6,0"/>
                <!-- 略往左移 -->
            </Grid>

            <!-- 右：设置按钮 -->
            <Frame Grid.Column="2"
           CornerRadius="18"
           HasShadow="False"
           BackgroundColor="Transparent"
           HeightRequest="36"
           WidthRequest="36"
           Padding="0"
           VerticalOptions="Center"
           HorizontalOptions="End"
           Margin="0,0,4,0">
                <ImageButton Source="settings.png"
                     BackgroundColor="Transparent"
                     HeightRequest="32"
                     WidthRequest="32"
                     Aspect="AspectFit"
                     Padding="0"
                     Clicked="OnSettingClicked"/>
            </Frame>

        </Grid>





        <!-- 搜索与筛选 -->
        <Grid Grid.Row="1"
      RowDefinitions="Auto,Auto,Auto,Auto"
      ColumnDefinitions="*"
      Margin="0,0,0,10"
      HorizontalOptions="FillAndExpand"
      RowSpacing="8">

            <!-- 第1行：L1 + L2 -->
            <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="6">
                <!-- L1 -->
                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="FillAndExpand">
                    <Label Text="What" FontAttributes="Bold" FontSize="14"/>
                    <Picker ItemsSource="{Binding L1Options}" 
                    SelectedItem="{Binding SelectedL1}" 
                    Title="Select a category"/>
                </VerticalStackLayout>

                <!-- L2 -->
                <VerticalStackLayout Grid.Column="1" Spacing="2" 
                             IsVisible="{Binding HasL1Selected}" 
                             x:Name="L2Panel"
                             HorizontalOptions="FillAndExpand">
                    <Label Text="Category" FontAttributes="Bold" FontSize="14"/>
                    <Picker ItemsSource="{Binding L2Options}" 
                    SelectedItem="{Binding SelectedL2}" 
                    Title="Select a subcategory"/>
                </VerticalStackLayout>
            </Grid>

            <!-- 第2行：L3 + 搜索框 -->
            <Grid Grid.Row="1" ColumnDefinitions="2*,*"
          ColumnSpacing="6" VerticalOptions="Center">
                <!-- L3 -->
                <VerticalStackLayout Grid.Column="0" Spacing="2"
                             IsVisible="{Binding HasL2Selected}" 
                             x:Name="L3Panel"
                             HorizontalOptions="FillAndExpand">
                    <Label Text="Topic" FontAttributes="Bold" FontSize="14"/>
                    <Picker ItemsSource="{Binding L3Options}" 
                    SelectedItem="{Binding SelectedL3}" 
                    Title="Select a topic"/>
                </VerticalStackLayout>

                <!-- 搜索框 + 搜索按钮 -->
                <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalOptions="Center">
                    <Frame Padding="8,0"
                   BackgroundColor="#F5F5F5"
                   CornerRadius="8"
                   HasShadow="False"
                   VerticalOptions="Center"
                   HorizontalOptions="FillAndExpand">
                        <Entry Placeholder="Search title..."
                       Text="{Binding SearchText}"
                       HeightRequest="40"
                       BackgroundColor="Transparent"
                       PlaceholderColor="#888"
                       TextColor="#333"
                       HorizontalOptions="FillAndExpand"/>
                    </Frame>

                    <Button Grid.Column="1"
                    Text="🔍"
                    FontSize="18"
                    WidthRequest="44"
                    HeightRequest="40"
                    CornerRadius="20"
                    BackgroundColor="#0078D7"
                    TextColor="White"
                    VerticalOptions="Center"
                    Clicked="OnSearchClicked"/>
                </Grid>
            </Grid>

            <!-- 第3行：Where + Day -->
            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="6">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Where" FontAttributes="Bold" FontSize="14"/>
                    <Picker ItemsSource="{Binding WhereOptions}" SelectedItem="{Binding SelectedWhere}"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="Day" FontAttributes="Bold" FontSize="14"/>
                    <Picker ItemsSource="{Binding DayOptions}" SelectedItem="{Binding SelectedDay}"/>
                </VerticalStackLayout>
            </Grid>

            <!-- 第4行：Time -->
            <VerticalStackLayout Grid.Row="3" Spacing="2" HorizontalOptions="FillAndExpand">
                <Label Text="Time" FontAttributes="Bold" FontSize="14"/>
                <Picker ItemsSource="{Binding TimeOptions}" SelectedItem="{Binding SelectedTime}"/>
            </VerticalStackLayout>

        </Grid>





        <!-- 列表卡片 -->
        <Grid Grid.Row="2" x:Name="ListRegion">

            <CollectionView Grid.Row="2" ItemsSource="{Binding Courses}" SelectionMode="Single" SelectionChanged="OnItemTapped">
                <CollectionView.EmptyView>
                    <Grid Padding="20">
                        <Label Text="No courses" HorizontalOptions="Center" VerticalOptions="Center" FontSize="16" TextColor="#666"/>
                    </Grid>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12" Margin="0,6" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" BackgroundColor="White">
                            <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Start" Margin="0,2,0,0">
                                <Label Text="↗" Opacity="0.3" FontSize="16"/>
                                <Label Text="♡" Opacity="0.3" FontSize="16"/>
                            </HorizontalStackLayout>

                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6">
                                <Border StrokeThickness="0" Padding="8,4" StrokeShape="RoundRectangle 8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FFA726" Offset="0"/>
                                            <GradientStop Color="#FFEE58" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="🎓" FontSize="12"/>
                                        <Label Text="COURSE" FontSize="12" FontAttributes="Bold" TextColor="White"/>
                                    </HorizontalStackLayout>
                                </Border>

                                <Label Text="{Binding Title}" TextColor="#6A1B9A" FontAttributes="Bold" FontSize="18"
                                       LineBreakMode="TailTruncation"/>

                                <Label>
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}Ref Code: {0}    By {1}">
                                            <Binding Path="ClassId"/>
                                            <Binding Path="OrganizerDisplay"/>
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>

                                <Label Text="{Binding Outlet}" TextColor="#F57C00"/>

                                <HorizontalStackLayout Spacing="18" Margin="0,4,0,0">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="📅"/>
                                        <Label>
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}Starts {0:ddd, dd MMM yyyy}">
                                                    <Binding Path="StartDate"/>
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="⏰"/>
                                        <Label Text="{Binding SessionTime}"/>
                                    </HorizontalStackLayout>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.RowSpan="2" Grid.Column="1" VerticalOptions="Center" Margin="12,0,0,0">
                                <Label FontAttributes="Bold" FontSize="16" Text="{Binding PriceRangeDisplay}" />
                            </VerticalStackLayout>

                            <BoxView Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="1" BackgroundColor="#EEEEEE" Margin="0,12,0,0"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!--加载动画-->
            <Grid BackgroundColor="#80000000" IsVisible="{Binding IsBusy}" InputTransparent="False">
                <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="True" WidthRequest="48" HeightRequest="48"/>
                    <Label Text="Loading..." TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                </StackLayout>
            </Grid>
        </Grid>

        <!-- 底部留白 -->
        <BoxView Grid.Row="3" HeightRequest="8" Opacity="0"/>
    </Grid>
</ContentPage>
