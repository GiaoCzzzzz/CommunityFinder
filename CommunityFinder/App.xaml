<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CommunityFinder"
             x:Class="CommunityFinder.App">

    <Application.Resources>
        <ResourceDictionary>

            <!-- Global Font Size for Elder Mode -->
            <x:Double x:Key="GlobalFontSize">12</x:Double>

            <!-- Global Label Style -->
            <Style TargetType="Label">
                <Setter Property="FontSize" Value="{DynamicResource GlobalFontSize}" />
            </Style>

            <!-- Global Button Style -->
            <Style TargetType="Button">
                <Setter Property="FontSize" Value="{DynamicResource GlobalFontSize}" />
            </Style>

            <!-- Global Shell Style (Navigation Bar) -->
            <Style TargetType="Shell">
                <Setter Property="TitleColor" Value="Black" />
                <Setter Property="BackgroundColor" Value="White" />
            </Style>

            <!-- Preserve existing color and style resources -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Application.Resources>

</Application>
