<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CommunityFinder.Views.ThemePage"
             Title="Theme Page"
             BackgroundColor="#DEF685">
    <VerticalStackLayout Padding="20" Spacing="20">
        <!-- Display current mode -->
        <Label x:Name="CurrentModeLabel" Text="Current Mode: Normal"
               HorizontalOptions="Center" VerticalOptions="Center"/>
        <!-- Normal Mode button -->
        <Button Text="Normal Mode" Clicked="NormalModeButton_Clicked"/>
        <!-- Elder Mode button -->
        <Button Text="Elder Mode" Clicked="ElderModeButton_Clicked"/>
    </VerticalStackLayout>
</ContentPage>
