<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CommunityFinder.AboutusPage"
             Title="About Us"
             BackgroundColor="#F9FFE3">

	<!-- 背景渐变 -->
	<ContentPage.Background>
		<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
			<GradientStop Color="#E9FFD6" Offset="0.0"/>
			<GradientStop Color="#DFF8B9" Offset="1.0"/>
		</LinearGradientBrush>
	</ContentPage.Background>

	<ScrollView>
		<VerticalStackLayout Padding="16" Spacing="24">

			<!-- 顶部标题 -->
			<Label x:Name="TitleLabel"
                   Text="Welcome to Community Finder"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#6A1B9A"
                   HorizontalOptions="Center"
                   Opacity="0"
                   Scale="0.5"/>

			<!-- About 卡片 -->
			<Frame CornerRadius="16" Padding="16" BackgroundColor="White" HasShadow="True">
				<VerticalStackLayout Spacing="12">
					<Label Text="About the App" FontSize="20" FontAttributes="Bold" TextColor="#5DBB63"/>
					<Label Text="Community Finder is a modern platform designed to help users discover courses, events, and communities that match their personal interests. Our smart recommendation system leverages AI to suggest content based on your browsing habits, favorites, and engagement, while fully respecting your privacy."
                           FontSize="14" TextColor="#2A2A2A" LineBreakMode="WordWrap"/>
				</VerticalStackLayout>
			</Frame>

			<!-- Core Features 卡片 -->
			<Frame CornerRadius="16" Padding="16" BackgroundColor="White" HasShadow="True">
				<VerticalStackLayout Spacing="8">
					<Label Text="Core Features" FontSize="20" FontAttributes="Bold" TextColor="#5DBB63"/>
					<Label Text="• Browse a wide variety of courses and events tailored to your interests" FontSize="14" TextColor="#2A2A2A" LineBreakMode="WordWrap"/>
					<Label Text="• Join chat groups to connect with like-minded users" FontSize="14" TextColor="#2A2A2A" LineBreakMode="WordWrap"/>
					<Label Text="• Register for events easily and securely" FontSize="14" TextColor="#2A2A2A" LineBreakMode="WordWrap"/>
					<Label Text="• Track your participation and rewards for completed tasks" FontSize="14" TextColor="#2A2A2A" LineBreakMode="WordWrap"/>
					<Label Text="• Access a detailed history of your activities" FontSize="14" TextColor="#2A2A2A" LineBreakMode="WordWrap"/>
					<Label Text="• AI-powered personalized recommendations based on interaction data" FontSize="14" TextColor="#2A2A2A" LineBreakMode="WordWrap"/>
					<Label Text="• Admins can manage events, review statistics, and generate reports" FontSize="14" TextColor="#2A2A2A" LineBreakMode="WordWrap"/>
				</VerticalStackLayout>
			</Frame>

			<!-- Privacy 卡片 -->
			<Frame CornerRadius="16" Padding="16" BackgroundColor="White" HasShadow="True">
				<VerticalStackLayout Spacing="12">
					<Label Text="Privacy &amp; Data Protection" FontSize="20" FontAttributes="Bold" TextColor="#5DBB63"/>
					<Label Text="At Community Finder, protecting your personal information is our top priority. This privacy policy explains how we collect, use, and safeguard your data." FontSize="14" TextColor="#2A2A2A"/>
					<Label Text="Data Collection" FontAttributes="Bold" FontSize="16"/>
					<Label Text="• We collect information you provide during registration, such as email and password." FontSize="14" TextColor="#2A2A2A" LineBreakMode="WordWrap"/>
					<Label Text="• We also track your course browsing, favorites, and event participation to provide personalized recommendations." FontSize="14" TextColor="#2A2A2A" LineBreakMode="WordWrap"/>
					<Label Text="• Data collection is limited to what is necessary for the core functionalities of the app." FontSize="14" TextColor="#2A2A2A" LineBreakMode="WordWrap"/>
					<Label Text="Data Usage" FontAttributes="Bold" FontSize="16"/>
					<Label Text="• Personal data is used to authenticate your account, provide services, and deliver personalized content." FontSize="14" TextColor="#2A2A2A" LineBreakMode="WordWrap"/>
					<Label Text="• Anonymized data may be used for improving AI recommendation algorithms." FontSize="14" TextColor="#2A2A2A" LineBreakMode="WordWrap"/>
					<Label Text="• We do not sell or share your personal information with third parties without your consent." FontSize="14" TextColor="#2A2A2A" LineBreakMode="WordWrap"/>
					<Label Text="Data Security" FontAttributes="Bold" FontSize="16"/>
					<Label Text="• All personal data is encrypted in transit and at rest." FontSize="14" TextColor="#2A2A2A" LineBreakMode="WordWrap"/>
					<Label Text="• Access to user data is strictly controlled and monitored." FontSize="14" TextColor="#2A2A2A" LineBreakMode="WordWrap"/>
					<Label Text="• We implement industry-standard measures to protect against unauthorized access, alteration, or deletion." FontSize="14" TextColor="#2A2A2A" LineBreakMode="WordWrap"/>
					<Label Text="User Rights" FontAttributes="Bold" FontSize="16"/>
					<Label Text="• Users can request access, correction, or deletion of their personal information." FontSize="14" TextColor="#2A2A2A" LineBreakMode="WordWrap"/>
					<Label Text="• You can opt out of AI-based personalized recommendations at any time." FontSize="14" TextColor="#2A2A2A" LineBreakMode="WordWrap"/>
					<Label Text="• Users are informed about all data collection practices and changes to privacy policies." FontSize="14" TextColor="#2A2A2A" LineBreakMode="WordWrap"/>
					<Label Text="Compliance" FontAttributes="Bold" FontSize="16"/>
					<Label Text="• We comply with GDPR and relevant local privacy regulations." FontSize="14" TextColor="#2A2A2A" LineBreakMode="WordWrap"/>
					<Label Text="• Any breach of data privacy will be promptly reported and addressed according to legal requirements." FontSize="14" TextColor="#2A2A2A" LineBreakMode="WordWrap"/>
				</VerticalStackLayout>
			</Frame>

			<!-- Terms 卡片 -->
			<Frame CornerRadius="16" Padding="16" BackgroundColor="White" HasShadow="True">
				<VerticalStackLayout Spacing="12">
					<Label Text="Terms of Use" FontSize="20" FontAttributes="Bold" TextColor="#5DBB63"/>
					<Label Text="By using Community Finder, you agree to abide by the following rules:" FontSize="14" TextColor="#2A2A2A"/>
					<Label Text="• Keep your account secure &amp; do not share login credentials." FontSize="14" TextColor="#2A2A2A" LineBreakMode="WordWrap"/>
					<Label Text="• Respect other users and their contributions in chats and events." FontSize="14" TextColor="#2A2A2A" LineBreakMode="WordWrap"/>
					<Label Text="• Ensure any content you submit complies with laws &amp; does not infringe on third-party rights." FontSize="14" TextColor="#2A2A2A" LineBreakMode="WordWrap"/>
					<Label Text="• The app is provided as-is, and we are not liable for external content or user-generated data." FontSize="14" TextColor="#2A2A2A" LineBreakMode="WordWrap"/>
					<Label Text="• Violations may result in account suspension or termination." FontSize="14" TextColor="#2A2A2A" LineBreakMode="WordWrap"/>
				</VerticalStackLayout>
			</Frame>

			<!-- 底部动画 🌟 -->
			<Label x:Name="StarLabel" Text="🌟" FontSize="36" HorizontalOptions="Center" VerticalOptions="Center"/>

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
