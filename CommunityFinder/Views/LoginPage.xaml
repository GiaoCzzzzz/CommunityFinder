<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CommunityFinder.Views.LoginPage"
             Title="LoginPage"
             BackgroundColor="#F9FFE3">

    <Grid>
        <!-- 顶部 Logo -->
        <Image Source="icon1.png" WidthRequest="60" HeightRequest="60"
               HorizontalOptions="Start" VerticalOptions="Start" Margin="10" />

        <!-- 主体滚动内容 -->
        <ScrollView>
            <StackLayout Padding="30" Spacing="20" VerticalOptions="Center">

                <Label Text="Log in" FontSize="28" FontAttributes="Bold"
                       HorizontalOptions="Center" TextColor="#333" Margin="0,0,0,10" />

                <!-- 邮箱 -->
                <Entry x:Name="EmailEntry"
                       Placeholder="Username / Email / Mobile Number"
                       PlaceholderColor="#000000"
                       FontSize="16"
                       BackgroundColor="#D9D9D9"
                       HeightRequest="50"
                       Margin="0,0,0,10"
                       TextChanged="OnEmailTextChanged" />
                <Label x:Name="EmailErrorLabel"
                       TextColor="Red"
                       FontSize="12"
                       IsVisible="False"
                       Margin="0,-10,0,10" />

                <!-- 密码 -->
                <Grid Margin="0,0,0,10">
                    <Entry x:Name="PasswordEntry"
                           Placeholder="Password"
                           PlaceholderColor="#000000"
                           IsPassword="True"
                           FontSize="16"
                           BackgroundColor="#D9D9D9"
                           HeightRequest="50"
                           HorizontalOptions="Fill"
                           TextChanged="OnPasswordTextChanged" />
                    <ImageButton x:Name="PasswordToggleButton"
                                 Source="icon4.png"
                                 BackgroundColor="Transparent"
                                 WidthRequest="12"
                                 HeightRequest="12"
                                 HorizontalOptions="End"
                                 VerticalOptions="Center"
                                 Margin="0,0,10,0"
                                 Clicked="OnPasswordToggleClicked"
                                 Aspect="AspectFit"
                                 Scale="0.6"/>
                </Grid>

                <!-- 密码规则 -->
                <StackLayout x:Name="PasswordRulesStack" IsVisible="False" Spacing="2">
                    <Label x:Name="PasswordRuleLength" FontSize="12" TextColor="Red" />
                    <Label x:Name="PasswordRuleUpper" FontSize="12" TextColor="Red" />
                    <Label x:Name="PasswordRuleLower" FontSize="12" TextColor="Red" />
                    <Label x:Name="PasswordRuleDigit" FontSize="12" TextColor="Red" />
                    <Label x:Name="PasswordRuleSpecial" FontSize="12" TextColor="Red" />
                </StackLayout>

                <!-- Confirm 按钮 -->
                <Button Text="Confirm"
                        Clicked="OnLoginClicked"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="50" />

                <!-- 忘记密码 -->
                <Label Text="Forget password？"
                       TextColor="#2196F3"
                       FontSize="14"
                       HorizontalOptions="Center"
                       Margin="0,10,0,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnForgotPasswordClicked" />
                    </Label.GestureRecognizers>
                </Label>

                <!-- 注册跳转 -->
                <Label Text="Don't have an account? Sign up now."
                       TextColor="#2196F3"
                       FontSize="14"
                       HorizontalOptions="Center"
                       Margin="0,5,0,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGoToSignUpClicked" />
                    </Label.GestureRecognizers>
                </Label>

            </StackLayout>
        </ScrollView>

        <!-- 🌈 超精美加载动画层 -->
        <Grid x:Name="LoadingOverlay"
              BackgroundColor="#80000000"
              IsVisible="False"
              Opacity="0">
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">
                <Frame Padding="25"
                       CornerRadius="50"
                       BackgroundColor="#FFFFFF"
                       HasShadow="True"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Scale="0.5">
                    <StackLayout>
                        <ActivityIndicator IsRunning="True"
                                           Color="#4CAF50"
                                           WidthRequest="60"
                                           HeightRequest="60" />
                        <Label Text="Logging in..."
                               FontSize="16"
                               TextColor="#333"
                               HorizontalOptions="Center"
                               Margin="0,10,0,0" />
                    </StackLayout>
                </Frame>
            </StackLayout>
        </Grid>
    </Grid>
</ContentPage>
