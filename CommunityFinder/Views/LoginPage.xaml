<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CommunityFinder.Views.LoginPage"
             Title="LoginPage"
             BackgroundColor="#F9FFE3">

    <Grid>
        <!-- 左上角图片 -->
        <Image
            Source="icon1.png"  
            WidthRequest="60"
            HeightRequest="60"
            HorizontalOptions="Start"
            VerticalOptions="Start"
            Margin="10" />

            <!-- 页面内容 -->
            <ScrollView>
                <StackLayout Padding="30" Spacing="20" VerticalOptions="Center">

                    <!-- 页面标题 -->
                    <Label
                    Text="Log in"
                    FontSize="28"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    TextColor="#333"
                    Margin="0,0,0,10" />

                    <!-- 用户名/邮箱/手机号输入框 -->
                    <Entry x:Name="EmailEntry"
                       Placeholder="Username / Email / Mobile Number"
                       PlaceholderColor="#000000"
                       FontSize="16"
                       BackgroundColor="#D9D9D9"
                       HeightRequest="50"
                       Margin="0,0,0,10" />

                    <!-- 密码输入框 -->
                    <Entry x:Name="PasswordEntry"
                       Placeholder="Password"
                       PlaceholderColor="#000000"
                       IsPassword="True"
                       FontSize="16"
                       BackgroundColor="#D9D9D9"
                       HeightRequest="50"
                       Margin="0,0,0,10" />

                    <!-- 登录按钮 -->
                    <Button Text="Confirm"
                        Clicked="OnLoginClicked"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="50" />

                    <!-- 忘记密码链接 -->
                    <Label Text="Forget password？"
                       TextColor="#2196F3"
                       FontSize="14"
                       HorizontalOptions="Center"
                       Margin="0,10,0,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnForgotPasswordClicked" />
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- 注册引导 -->
                    <Label Text="Don't have an account? Sign up now."
                       TextColor="#2196F3"
                       FontSize="14"
                       HorizontalOptions="Center"
                       Margin="0,5,0,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGoToSignUpClicked" />
                        </Label.GestureRecognizers>
                    </Label>

                </StackLayout>
            </ScrollView>
    </Grid>
</ContentPage>
