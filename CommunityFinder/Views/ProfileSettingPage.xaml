<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CommunityFinder.Views.ProfileSettingPage"
    Title="About You"
    BackgroundColor="#F9FFE3">

    <ScrollView>
        <StackLayout Padding="30" Spacing="20" VerticalOptions="Center">

            <Label Text="About You" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#333" />

            <Label Text="Email" FontSize="14" TextColor="#333" />
            <Entry x:Name="EmailEntry" IsReadOnly="True" BackgroundColor="#FFFFFF" HeightRequest="48" FontSize="16" />

            <Label Text="Display Name" FontSize="14" TextColor="#333" />
            <Entry x:Name="DisplayNameEntry" BackgroundColor="#FFFFFF" HeightRequest="48" FontSize="16" />

            <Label Text="Gender" FontSize="14" TextColor="#333" />
            <Picker x:Name="SexPicker" Title="Select your gender" BackgroundColor="#FFFFFF" HeightRequest="48" FontSize="16">
                <Picker.Items>
                    <x:String>Male</x:String>
                    <x:String>Female</x:String>
                </Picker.Items>
            </Picker>

            <Label Text="Age" FontSize="14" TextColor="#333" />
            <Entry x:Name="AgeEntry" Keyboard="Numeric" BackgroundColor="#FFFFFF" HeightRequest="48" FontSize="16" TextChanged="OnAgeChanged" />
            <Label x:Name="AgeErrorLabel" TextColor="Red" FontSize="12" IsVisible="False" />

            <Label Text="Nationality" FontSize="14" TextColor="#333" />
            <Picker x:Name="NationalityPicker" Title="Select your nationality" BackgroundColor="#FFFFFF" HeightRequest="48" FontSize="16" SelectedIndexChanged="OnNationalityChanged" />
            <Label x:Name="NationalityErrorLabel" TextColor="Red" FontSize="12" IsVisible="False" />

            <Label Text="Phone Number" FontSize="14" TextColor="#333" />
            <Entry x:Name="PhoneEntry" Keyboard="Telephone" BackgroundColor="#FFFFFF" HeightRequest="48" FontSize="16" TextChanged="OnPhoneChanged" />
            <Label x:Name="PhoneErrorLabel" TextColor="Red" FontSize="12" IsVisible="False" />

            <Label Text="Occupation" FontSize="14" TextColor="#333" />
            <Picker x:Name="OccupationPicker" Title="Select your occupation" BackgroundColor="#FFFFFF" HeightRequest="48" FontSize="16" SelectedIndexChanged="OnOccupationChanged" />
            <Label x:Name="OccupationErrorLabel" TextColor="Red" FontSize="12" IsVisible="False" />

            <Label Text="Postal Code" FontSize="14" TextColor="#333" />
            <Entry x:Name="PostalCodeEntry" Keyboard="Numeric" BackgroundColor="#FFFFFF" HeightRequest="48" FontSize="16" TextChanged="OnPostalCodeChanged" />
            <Label x:Name="PostalCodeErrorLabel" TextColor="Red" FontSize="12" IsVisible="False" />

            <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                <Button Text="Change Password" BackgroundColor="Transparent" TextColor="#2196F3" FontSize="14" Clicked="OnChangePasswordClicked" />
                <Button Text="Change Interest" BackgroundColor="Transparent" TextColor="#2196F3" FontSize="14" Clicked="OnChangeInterestClicked" />
                <Button Text="Save" BackgroundColor="#4CAF50" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="50" Clicked="OnSaveClicked" />
            </HorizontalStackLayout>

        </StackLayout>
    </ScrollView>
</ContentPage>
