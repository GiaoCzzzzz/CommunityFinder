<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CommunityFinder.Views.ProfileSettingPage"
             Title="About You"
             BackgroundColor="#F9FFE3">

    <ScrollView>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧纵向导航 -->
            <VerticalStackLayout Grid.Column="0" Padding="12" Spacing="8"
                                 BackgroundColor="#F2F4F7">
                <Button Text="Account" FontAttributes="Bold" Padding="10,8"
                        BackgroundColor="#E5E7EB" TextColor="Black"/>
                <Button Text="Language"  Clicked="OnLanguageClicked"  />
                <Button Text="Theme"     Clicked="OnThemeClicked"     />
                <Button Text="History"   Clicked="OnHistoryClicked"   />
            </VerticalStackLayout>

            <!-- 右侧内容 -->
            <StackLayout Padding="30" Spacing="20" VerticalOptions="Center" Grid.Column="1">

                <Label Text="About You" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#333" />

                <Label Text="Email" FontSize="14" TextColor="#333" />
                <Entry x:Name="EmailEntry" IsReadOnly="True" BackgroundColor="#F9FFE3" HeightRequest="48" FontSize="16" />

                <Label Text="Display Name" FontSize="14" TextColor="#333" />
                <Entry x:Name="DisplayNameEntry" BackgroundColor="#F9FFE3" HeightRequest="48" FontSize="16" />

                <Label Text="Gender" FontSize="14" TextColor="#333" />
                <Picker x:Name="SexPicker" Title="Select your gender" BackgroundColor="#F9FFE3" HeightRequest="48" FontSize="16">
                    <Picker.Items>
                        <x:String>Male</x:String>
                        <x:String>Female</x:String>
                    </Picker.Items>
                </Picker>

                <Label Text="Age" FontSize="14" TextColor="#333" />
                <Entry x:Name="AgeEntry" Keyboard="Numeric" BackgroundColor="#F9FFE3" HeightRequest="48" FontSize="16" TextChanged="OnAgeChanged" />
                <Label x:Name="AgeErrorLabel" TextColor="Red" FontSize="12" IsVisible="False" />

                <!-- Nationality -->
                <Label Text="Nationality" FontSize="14" TextColor="#333" />
                <Entry x:Name="NationalitySearchEntry" Placeholder="Search Nationality" TextChanged="OnNationalitySearchChanged" />
                <Button Text="▼ Show/Hide Nationality List" Clicked="OnToggleNationalityListClicked" BackgroundColor="#DEF685" TextColor="Black" CornerRadius="20" HeightRequest="40" />
                <CollectionView x:Name="NationalityListView" IsVisible="False" SelectionMode="Single" SelectionChanged="OnNationalitySelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Label Text="{Binding}" Padding="10" BackgroundColor="#DEF685" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Label x:Name="NationalityErrorLabel" TextColor="Red" FontSize="12" IsVisible="False" />

                <Label Text="Phone Number" FontSize="14" TextColor="#333" />
                <Entry x:Name="PhoneEntry" Keyboard="Telephone" BackgroundColor="#F9FFE3" HeightRequest="48" FontSize="16" TextChanged="OnPhoneChanged" />
                <Label x:Name="PhoneErrorLabel" TextColor="Red" FontSize="12" IsVisible="False" />

                <!-- Occupation -->
                <Label Text="Occupation" FontSize="14" TextColor="#333" />
                <Entry x:Name="OccupationSearchEntry" Placeholder="Search Occupation" TextChanged="OnOccupationSearchChanged" />
                <Button Text="▼ Show/Hide Occupation List" Clicked="OnToggleOccupationListClicked" BackgroundColor="#DEF685" TextColor="Black" CornerRadius="20" HeightRequest="40" />
                <CollectionView x:Name="OccupationListView" IsVisible="False" SelectionMode="Single" SelectionChanged="OnOccupationSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Label Text="{Binding}" Padding="10" BackgroundColor="#DEF685" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Label x:Name="OccupationErrorLabel" TextColor="Red" FontSize="12" IsVisible="False" />

                <Label Text="Postal Code" FontSize="14" TextColor="#333" />
                <Entry x:Name="PostalCodeEntry" Keyboard="Numeric" BackgroundColor="#F9FFE3" HeightRequest="48" FontSize="16" TextChanged="OnPostalCodeChanged" />
                <Label x:Name="PostalCodeErrorLabel" TextColor="Red" FontSize="12" IsVisible="False" />

                <Grid ColumnSpacing="10" RowSpacing="15" Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 第一行：两个按钮并排 -->
                    <Button Grid.Row="0" Grid.Column="0"
            Text="Change Password"
            BackgroundColor="Transparent"
            TextColor="#2196F3"
            FontSize="14"
            Clicked="OnChangePasswordClicked"
            Padding="10,5"/>

                    <Button Grid.Row="0" Grid.Column="1"
            Text="Change Interest"
            BackgroundColor="Transparent"
            TextColor="#2196F3"
            FontSize="14"
            Clicked="OnChangeInterestClicked"
            Padding="10,5"/>

                    <!-- 第二行：Save 按钮占满整行 -->
                    <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
            Text="Save"
            BackgroundColor="#4CAF50"
            TextColor="White"
            FontAttributes="Bold"
            CornerRadius="8"
            HeightRequest="50"
            Clicked="OnSaveClicked"
            HorizontalOptions="Fill"
            Padding="10,5"/>
                </Grid>






            </StackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
