<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CommunityFinder.Services"
             x:Class="CommunityFinder.Views.HistoryPage"
             x:Name="ThisPage"
             Title="{x:Static local:LangManager.HistoryPage_Title}"
             BackgroundColor="#DEF685">

    <ScrollView>
        <StackLayout Padding="10">

            <!-- =============== 搜索区域 =============== -->
            <Frame x:Name="FrameSearchArea"
                   BackgroundColor="#CDE6F5"
                   Padding="10"
                   CornerRadius="8"
                   HasShadow="True"
                   Margin="0,10,0,20">

                <VerticalStackLayout x:Name="SearchStack" Spacing="10">

                    <!-- 搜索输入框 + 搜索按钮 -->
                    <HorizontalStackLayout x:Name="SearchRow" Spacing="8">

                        <Entry x:Name="SearchEntry"
                               Placeholder="{x:Static local:LangManager.HistoryPage_SearchPlaceholder}"
                               Text="{Binding SearchText}"
                               BackgroundColor="White"
                               PlaceholderColor="Gray"
                               FontSize="16"
                               HorizontalOptions="FillAndExpand"
                               Margin="0,5" />

                        <Button x:Name="BtnSearch"
                                Text="{x:Static local:LangManager.HistoryPage_SearchButton}"
                                BackgroundColor="#4A90E2"
                                TextColor="White"
                                Padding="12,6"
                                Clicked="OnSearchButtonClicked"/>
                    </HorizontalStackLayout>

                    <!-- 分类筛选：范围与类型 -->
                    <HorizontalStackLayout x:Name="FilterRow" Spacing="10">

                        <!-- 搜索范围选择 -->
                        <Picker x:Name="ScopePicker"
        Title="Scope"
        SelectedIndexChanged="OnScopeChanged">
                            <Picker.Items>
                                <x:String>All</x:String>
                                <x:String>Browsing History</x:String>
                                <x:String>Favorite Courses</x:String>
                            </Picker.Items>
                        </Picker>

                        <Picker x:Name="TypePicker"
        Title="Type"
        SelectedIndexChanged="OnTypeChanged">
                            <Picker.Items>
                                <x:String>All</x:String>
                                <x:String>Course</x:String>
                                <x:String>Event</x:String>
                            </Picker.Items>
                        </Picker>


                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- ====================== Browsing History ====================== -->
            <Label x:Name="LblBrowsingHistory"
                   Text="{x:Static local:LangManager.HistoryPage_BrowsingHistoryTitle}"
                   FontSize="24"
                   HorizontalOptions="Center"
                   Margin="0,10"/>

            <Button x:Name="BtnClearHistory"
                    Text="{x:Static local:LangManager.HistoryPage_ClearHistory}"
                    BackgroundColor="#EF8687"
                    TextColor="White"
                    Margin="10"
                    Clicked="OnClearAllHistoryClicked"/>

            <CollectionView x:Name="CVBrowsingHistory"
                            ItemsSource="{Binding FilteredBrowsingHistory}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame x:Name="FrameHistoryItem"
                               Margin="10"
                               Padding="10"
                               HasShadow="True"
                               CornerRadius="8">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnHistoryCardTapped" 
                                     CommandParameter="{Binding .}"/>
                            </Frame.GestureRecognizers>
                            <Frame.Style>
                                <Style TargetType="Frame">
                                    <Setter Property="BackgroundColor" Value="#D5B7B6"/>
                                    <Style.Triggers>
                                        <DataTrigger TargetType="Frame" Binding="{Binding ItemType}" Value="COURSE">
                                            <Setter Property="BackgroundColor" Value="#A4C2F4"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Frame" Binding="{Binding ItemType}" Value="EVENT">
                                            <Setter Property="BackgroundColor" Value="#EAD1DC"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Frame.Style>

                            <StackLayout Orientation="Horizontal" VerticalOptions="Center">
                                <StackLayout x:Name="HistoryItemDetails" HorizontalOptions="StartAndExpand">
                                    <HorizontalStackLayout x:Name="HistoryItemTypeRow" Spacing="8" Margin="0,0,0,4">
                                        <Label x:Name="LblHistoryItemType"
                                               Text="{Binding ItemType}"
                                               FontSize="10"
                                               BackgroundColor="#FFA726"
                                               TextColor="White"
                                               Padding="4,2"
                                               FontAttributes="Bold"/>
                                    </HorizontalStackLayout>

                                    <Label x:Name="LblHistoryItemTitle"
                                           Text="{Binding Title}"
                                           FontSize="18"
                                           FontAttributes="Bold"/>
                                    <Label x:Name="LblHistoryItemOutlet"
                                           Text="{Binding Outlet}"
                                           FontSize="14"
                                           TextColor="Gray"/>
                                </StackLayout>

                                <Button x:Name="BtnDeleteHistoryItem"
                                        Text="{x:Static local:LangManager.HistoryPage_Delete}"
                                        BackgroundColor="#EF8687"
                                        TextColor="White"
                                        Padding="10,5"
                                        Command="{Binding BindingContext.DeleteHistoryCommand, Source={x:Reference ThisPage}}"
                                        CommandParameter="{Binding .}"/>
                                <Button x:Name="BtnSelectHistoryItem"
                                        Text="{x:Static local:LangManager.HistoryPage_Add}"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        CornerRadius="18"
                                        BackgroundColor="#4A90E2"
                                        TextColor="White"
                                        FontSize="20"
                                        Margin="8,0,0,0"
                                        Clicked="OnSelectButtonClicked"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding Source={x:Reference ThisPage}, Path=IsSelectionMode}" />
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- ====================== Favorite Courses ====================== -->
            <Label x:Name="LblFavoriteCourses"
                   Text="{x:Static local:LangManager.HistoryPage_FavoriteCoursesTitle}"
                   FontSize="24"
                   HorizontalOptions="Center"
                   Margin="0,10"/>

            <Button x:Name="BtnClearFavorites"
                    Text="{x:Static local:LangManager.HistoryPage_ClearFavorites}"
                    BackgroundColor="#EF8687"
                    TextColor="White"
                    Margin="10"
                    Clicked="OnClearAllFavoritesClicked"/>

            <CollectionView x:Name="CVFavoriteCourses"
                            ItemsSource="{Binding FilteredFavoriteCourses}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame x:Name="FrameFavoriteItem"
                               Margin="10"
                               Padding="10"
                               HasShadow="True"
                               CornerRadius="8">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFavoriteCardTapped" 
                                         CommandParameter="{Binding .}"/>
                            </Frame.GestureRecognizers>
                            <Frame.Style>
                                <Style TargetType="Frame">
                                    <Setter Property="BackgroundColor" Value="#88ACBC"/>
                                    <Style.Triggers>
                                        <DataTrigger TargetType="Frame" Binding="{Binding ItemType}" Value="COURSE">
                                            <Setter Property="BackgroundColor" Value="#A4C2F4"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Frame" Binding="{Binding ItemType}" Value="EVENT">
                                            <Setter Property="BackgroundColor" Value="#EAD1DC"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Frame.Style>

                            <StackLayout Orientation="Horizontal" VerticalOptions="Center">
                                <StackLayout x:Name="FavoriteItemDetails" HorizontalOptions="StartAndExpand">
                                    <HorizontalStackLayout x:Name="FavoriteItemTypeRow" Spacing="8" Margin="0,0,0,4">
                                        <Label x:Name="LblFavoriteItemType"
                                               Text="{Binding ItemType}"
                                               FontSize="10"
                                               BackgroundColor="#FFA726"
                                               TextColor="White"
                                               Padding="4,2"
                                               FontAttributes="Bold"/>
                                    </HorizontalStackLayout>

                                    <Label x:Name="LblFavoriteItemTitle"
                                           Text="{Binding Title}"
                                           FontSize="18"
                                           FontAttributes="Bold"/>
                                    <Label x:Name="LblFavoriteItemOutlet"
                                           Text="{Binding Outlet}"
                                           FontSize="14"
                                           TextColor="Gray"/>
                                </StackLayout>

                                <Button x:Name="BtnDeleteFavoriteItem"
                                        Text="{x:Static local:LangManager.HistoryPage_Delete}"
                                        BackgroundColor="#EF8687"
                                        TextColor="White"
                                        Padding="10,5"
                                        Command="{Binding BindingContext.DeleteFavoriteCourseCommand, Source={x:Reference ThisPage}}"
                                        CommandParameter="{Binding .}"/>
                                <Button x:Name="BtnSelectFavoriteItem"
                                        Text="{x:Static local:LangManager.HistoryPage_Add}"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        CornerRadius="18"
                                        BackgroundColor="#4A90E2"
                                        TextColor="White"
                                        FontSize="20"
                                        Margin="8,0,0,0"
                                        Clicked="OnSelectButtonClicked"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding Source={x:Reference ThisPage}, Path=IsSelectionMode}" />
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </StackLayout>
    </ScrollView>
</ContentPage>
