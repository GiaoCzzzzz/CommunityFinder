<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CommunityFinder.Views.LanguagePage"
             BackgroundColor="#DEF685">

    <VerticalStackLayout Padding="20" Spacing="20"
                         VerticalOptions="Center"
                         HorizontalOptions="Center">

        <!-- 当前语言显示 -->
        <Label x:Name="CurrentLangLabel"
               Text=""
               FontSize="20"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <!-- 英语按钮 -->
        <Button x:Name="EnglishButton"
                BackgroundColor="#4A90E2"
                TextColor="White"
                Padding="15"
                Clicked="OnEnglishClicked" />

        <!-- 中文按钮 -->
        <Button x:Name="ChineseButton"
                BackgroundColor="#28A745"
                TextColor="White"
                Padding="15"
                Clicked="OnChineseClicked" />

        <!-- 马来文按钮 -->
        <Button x:Name="MalayButton"
                BackgroundColor="#F5A623"
                TextColor="White"
                Padding="15"
                Clicked="OnMalayClicked" />

    </VerticalStackLayout>
</ContentPage>
