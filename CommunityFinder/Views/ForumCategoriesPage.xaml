<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CommunityFinder.Views.ForumCategoriesPage"
             Title="Forum"
             BackgroundColor="#F9FFE3">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- 🔍 Search Bar -->
        <Frame Grid.Row="0"
               BackgroundColor="White"
               Padding="12"
               Margin="16,16,16,0"
               CornerRadius="14"
               HasShadow="True">
            <Entry Placeholder="Search posts by topic..."
                   x:Name="SearchEntry"
                   TextChanged="OnSearchTextChanged"
                   BackgroundColor="White"
                   FontSize="16" />
        </Frame>


        <!-- 分类网格 -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="12" Spacing="14">

                <CollectionView x:Name="CategoriesCollection"
                                ItemsLayout="VerticalGrid,2"
                                SelectionMode="Single"
                                SelectionChanged="OnCategorySelected">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BackgroundColor="#4A90E2"
                                   CornerRadius="18"
                                   HasShadow="True"
                                   Padding="10"
                                   HeightRequest="160">

                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCategoryTapped" />
                                </Frame.GestureRecognizers>

                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">

                                    <!-- 图片 -->
                                    <Image Source="{Binding ImagePath}"
                                           HeightRequest="90"
                                           WidthRequest="180"
                                           Aspect="AspectFit" />

                                    <!-- 分类名称 -->
                                    <Label Text="{Binding Name}"
                                           TextColor="White"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>


                <!-- ➕ Add Category Button (Admin Only) -->
                <Button x:Name="AddCategoryButton"
                        Text="+ Add Category (Admin)"
                        BackgroundColor="#28A745"
                        TextColor="White"
                        CornerRadius="12"
                        IsVisible="False"
                        Clicked="OnAddCategoryClicked"
                        Margin="0,12,0,0"
                        HeightRequest="48"
                        FontAttributes="Bold" />

            </VerticalStackLayout>
        </ScrollView>


        <!-- 📌 Floating My Posts Button (Bottom Right) -->
        <Frame Grid.Row="2"
               BackgroundColor="#FF6347"
               CornerRadius="50"
               Padding="18"
               Margin="0,0,24,24"
               HorizontalOptions="End"
               VerticalOptions="End"
               HasShadow="True">

            <Frame.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMyPostsClicked" />
            </Frame.GestureRecognizers>

            <Label Text="My Posts"
                   TextColor="White"
                   FontAttributes="Bold"
                   FontSize="16"/>
        </Frame>

    </Grid>
</ContentPage>
