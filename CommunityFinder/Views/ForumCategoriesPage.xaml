<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CommunityFinder.Views.ForumCategoriesPage"
             x:Name="PageRoot"
             Title="Forum"
             BackgroundColor="#F9FFE3">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- 🔍 Search Bar -->
        <Frame Grid.Row="0"
               BackgroundColor="White"
               Padding="12"
               Margin="16,16,16,0"
               CornerRadius="14"
               HasShadow="True">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Placeholder="Search posts by topic..."
                       x:Name="SearchEntry"
                       BackgroundColor="White"
                       FontSize="16"
                       Completed="OnSearchCompleted" />

                <Button Text="Search"
                        Grid.Column="1"
                        BackgroundColor="#4A90E2"
                        TextColor="White"
                        Clicked="OnSearchButtonClicked"
                        CornerRadius="10"
                        Padding="12,10" />
            </Grid>
        </Frame>


        <!-- 分类网格 -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="12" Spacing="14">

                <!-- 推荐最多浏览的分类 -->
                <VerticalStackLayout x:Name="TopVisitedSection"
                                     Spacing="8"
                                     IsVisible="False"
                                     Padding="4,0">
                    <Label Text="Recommended for you"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="#333" />
                    <HorizontalStackLayout x:Name="TopVisitedLayout"
                                           Spacing="10">
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <CollectionView x:Name="CategoriesCollection"
                                ItemsLayout="VerticalGrid,2"
                                SelectionMode="Single"
                                SelectionChanged="OnCategorySelected">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BackgroundColor="#4A90E2"
                                   CornerRadius="18"
                                   HasShadow="True"
                                   Padding="10"
                                   HeightRequest="200">

                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCategoryTapped" />
                                </Frame.GestureRecognizers>

                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">

                                    <!-- 图片 -->
                                    <Image Grid.Row="0"
                                           Source="{Binding ImagePath}"
                                           HeightRequest="90"
                                           WidthRequest="180"
                                           Aspect="AspectFit"
                                           HorizontalOptions="Center" />

                                    <!-- 分类名称 -->
                                    <Label Grid.Row="1"
                                           Text="{Binding Name}"
                                           TextColor="White"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           HorizontalOptions="FillAndExpand"
                                           LineBreakMode="WordWrap" />

                                    <!-- 管理员专用：操作按钮 -->
                                    <VerticalStackLayout Grid.Row="2"
                                                         Spacing="6"
                                                         IsVisible="{Binding Source={x:Reference PageRoot}, Path=IsAdmin}">
                                        <Button Text="Reports"
                                                BackgroundColor="#DC3545"
                                                TextColor="White"
                                                Padding="10,6"
                                                Clicked="OnReportsClicked" />

                                        <Button Text="Delete Category"
                                                BackgroundColor="#6C757D"
                                                TextColor="White"
                                                Padding="10,6"
                                                Clicked="OnDeleteCategoryClicked"
                                                CommandParameter="{Binding Id}" />
                                    </VerticalStackLayout>

                                    <!-- 为 admin 预留空间，非 admin 时保持布局 -->
                                    <BoxView Grid.Row="3"
                                             HeightRequest="1"
                                             IsVisible="{Binding Source={x:Reference PageRoot}, Path=IsAdmin}" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>


                <!-- ➕ Add Category Button (Admin Only) -->
                <Button x:Name="AddCategoryButton"
                        Text="+ Add Category (Admin)"
                        BackgroundColor="#28A745"
                        TextColor="White"
                        CornerRadius="12"
                        IsVisible="False"
                        Clicked="OnAddCategoryClicked"
                        Margin="0,12,0,0"
                        HeightRequest="48"
                        FontAttributes="Bold" />

                <Button x:Name="ReportsButton"
                    Text="Reports"
                    IsVisible="False"          
                    BackgroundColor="#DC3545"
                    TextColor="White"
                    Padding="10,6"
                    Clicked="OnReportsClicked" />

            </VerticalStackLayout>
        </ScrollView>


        <!-- 📌 Floating My Posts Button (Bottom Right) -->
        <Frame Grid.Row="2"
               BackgroundColor="#FF6347"
               CornerRadius="50"
               Padding="18"
               Margin="0,0,24,24"
               HorizontalOptions="End"
               VerticalOptions="End"
               HasShadow="True">

            <Frame.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMyPostsClicked" />
            </Frame.GestureRecognizers>

            <Label Text="My Posts"
                   TextColor="White"
                   FontAttributes="Bold"
                   FontSize="16"/>
        </Frame>

    </Grid>
</ContentPage>
