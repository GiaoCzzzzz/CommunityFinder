<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CommunityFinder.Views.ForumCategoriesPage"
             Title="Forum"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Search Bar -->
        <Frame Grid.Row="0" BackgroundColor="White" Padding="10" Margin="10,10,10,0" CornerRadius="8" HasShadow="True">
            <Entry Placeholder="Search posts by topic..." 
                   x:Name="SearchEntry"
                   TextChanged="OnSearchTextChanged"
                   BackgroundColor="White"/>
        </Frame>

        <!-- Categories Grid -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="10" Spacing="10">
                <CollectionView x:Name="CategoriesCollection" 
                                SelectionMode="Single"
                                SelectionChanged="OnCategorySelected">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BackgroundColor="#4A90E2" 
                                   CornerRadius="12" 
                                   HasShadow="True"
                                   Padding="15"
                                   HeightRequest="120">
                                <Label Text="{Binding Name}" 
                                       TextColor="White"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       LineBreakMode="WordWrap"/>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Add Category Button (Admin Only) -->
                <Button x:Name="AddCategoryButton"
                        Text="+ Add Category (Admin)"
                        BackgroundColor="#28A745"
                        TextColor="White"
                        IsVisible="False"
                        Clicked="OnAddCategoryClicked"
                        Margin="0,10,0,0"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- My Posts Button (Bottom Right) -->
        <Frame Grid.Row="2" 
               BackgroundColor="#FF6347"
               CornerRadius="30"
               Padding="15,10"
               Margin="0,0,20,20"
               HorizontalOptions="End"
               VerticalOptions="End"
               HasShadow="True">
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMyPostsClicked"/>
            </Frame.GestureRecognizers>
            <Label Text="My Posts" 
                   TextColor="White"
                   FontAttributes="Bold"
                   FontSize="16"/>
        </Frame>
    </Grid>
</ContentPage>
