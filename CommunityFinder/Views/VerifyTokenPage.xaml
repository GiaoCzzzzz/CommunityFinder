<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CommunityFinder.Views.VerifyTokenPage"
             Title="VerifyTokenPage"
             BackgroundColor="#F9FFE3">

    <Grid RowDefinitions="Auto,*">
        <!-- 右上角图片 -->
        <Image Grid.Row="0"
               Source="icon1.png"  
            WidthRequest="60"
               HeightRequest="60"
               HorizontalOptions="End"
               VerticalOptions="Start"
               Margin="0,10,10,0" />

            <!-- 页面内容区域 -->
            <VerticalStackLayout Grid.Row="1" Padding="30" Spacing="15">
                <Label Text="Enter the verification code"
                   FontSize="24"
                   HorizontalOptions="Center"
                   TextColor="#333" />

                <Entry x:Name="TokenEntry"
                   Placeholder="Verification code"
                   PlaceholderColor="#000000"
                   Keyboard="Email"
                   BackgroundColor="#D9D9D9"
                   HeightRequest="50" />

                <Button Text="Verification"
                    Clicked="OnVerifyClicked"
                    HorizontalOptions="Center"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50" />
            </VerticalStackLayout>
    </Grid>
</ContentPage>
