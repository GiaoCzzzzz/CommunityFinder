<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Events"
             x:Class="CommunityFinder.Views.EventPage"
             BackgroundColor="#F9FFE3">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E9FFD6" Offset="0.0"/>
            <GradientStop Color="#DFF8B9" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto,Auto,*" Padding="12">
        <!-- 页面标题 -->
        <Label Grid.Row="0" 
               Text="Select Event Category" 
               FontSize="18" 
               FontAttributes="Bold"
               TextColor="#333"
               Margin="0,0,0,16"/>

        <!-- 事件分类按钮（垂直滚动） -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="10" Padding="0,0,0,20">

                <CollectionView ItemsSource="{Binding EventCategories}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Button 
                                Text="{Binding .}"
                                FontSize="16"
                                FontAttributes="Bold"
                                Padding="20,16"
                                Margin="0,4"
                                CornerRadius="8"
                                BackgroundColor="#0078D7"
                                TextColor="White"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectCategoryCommand}"
                                CommandParameter="{Binding .}"/>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
