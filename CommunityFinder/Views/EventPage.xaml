<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Events"
             x:Class="CommunityFinder.Views.EventPage"
             BackgroundColor="#F9FFE3">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E9FFD6" Offset="0.0"/>
            <GradientStop Color="#DFF8B9" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,*" Padding="12">
            <!-- 页面标题 -->
            <Label Grid.Row="0" 
                   Text="Select Event Category" 
                   FontSize="18" 
                   FontAttributes="Bold"
                   TextColor="#333"
                   Margin="0,0,0,16"/>

            <!-- 事件分类按钮（垂直滚动） -->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="10" Padding="0,0,0,20">

                    <CollectionView ItemsSource="{Binding EventCategories}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Padding="10" Margin="0,4" CornerRadius="8" BackgroundColor="#0078D7">
                                    <Grid ColumnDefinitions="Auto,*" VerticalOptions="Center">
                                        <!-- 图片 -->
                                        <Image Source="{Binding ImagePath}" 
                                               WidthRequest="40" 
                                               HeightRequest="40" 
                                               Margin="0,0,10,0"/>

                                        <!-- 文字 -->
                                        <Label Grid.Column="1"
                                               Text="{Binding Name}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               VerticalOptions="Center"/>

                                        <!-- 点击整个 Grid 触发命令 -->
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectCategoryCommand}"
                                                CommandParameter="{Binding .}"/>
                                        </Grid.GestureRecognizers>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>

        </Grid>
    </ScrollView>
</ContentPage>


