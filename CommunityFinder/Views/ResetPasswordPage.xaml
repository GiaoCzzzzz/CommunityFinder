<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CommunityFinder.Views.ResetPasswordPage"
    Title="Reset Password"
    BackgroundColor="#F9FFE3">

    <ScrollView>
        <StackLayout Padding="30" Spacing="20" VerticalOptions="Center">

            <!-- 顶部图标 -->
            <HorizontalStackLayout HorizontalOptions="End">
                <Border HeightRequest="60" WidthRequest="60"
                        Background="#FFF59D"
                        StrokeShape="RoundRectangle 30"
                        HorizontalOptions="End" VerticalOptions="Start">
                    <Image Source="reset_icon.png" HeightRequest="36" WidthRequest="36"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </HorizontalStackLayout>

            <!-- 页面标题 -->
            <Label Text="Reset Password" FontSize="28" FontAttributes="Bold"
                   HorizontalOptions="Center" TextColor="#333" />

            <!-- 新密码 -->
            <StackLayout Spacing="4">
                <!-- 新增提示文字 -->
                <Label Text="The new password cannot be the same as the old one."
                       FontSize="13" TextColor="Red" />

                <Label Text="Create new password*" FontSize="14" TextColor="#333" />
                <Grid ColumnDefinitions="*,Auto">
                    <Entry x:Name="PasswordEntry"
                           Placeholder="Please enter a new password"
                           PlaceholderColor="#000000"
                           IsPassword="True"
                           BackgroundColor="#F9FFE3"
                           HeightRequest="48"
                           FontSize="16"
                           TextChanged="OnPasswordTextChanged"
                           Grid.Column="0" />
                    <ImageButton Source="eye_icon.png"
                                 HeightRequest="24" WidthRequest="24"
                                 BackgroundColor="Transparent"
                                 Clicked="OnTogglePasswordClicked"
                                 Grid.Column="1" />
                </Grid>

                <!-- 密码规则提示 -->
                <StackLayout x:Name="PasswordRulesStack" IsVisible="False" Spacing="2">
                    <Label x:Name="PasswordRuleLength" FontSize="12" TextColor="Red" />
                    <Label x:Name="PasswordRuleUpper" FontSize="12" TextColor="Red" />
                    <Label x:Name="PasswordRuleLower" FontSize="12" TextColor="Red" />
                    <Label x:Name="PasswordRuleDigit" FontSize="12" TextColor="Red" />
                    <Label x:Name="PasswordRuleSpecial" FontSize="12" TextColor="Red" />
                </StackLayout>
            </StackLayout>

            <!-- 确认密码 -->
            <StackLayout Spacing="4">
                <Label Text="Confirm Password*" FontSize="14" TextColor="#333" />
                <Entry x:Name="ConfirmEntry"
                       Placeholder="Please Enter"
                       PlaceholderColor="#000000"
                       IsPassword="True"
                       BackgroundColor="#F9FFE3"
                       HeightRequest="48"
                       FontSize="16"
                       TextChanged="OnConfirmPasswordTextChanged" />
                <StackLayout x:Name="ConfirmRulesStack" IsVisible="False" Spacing="2">
                    <Label x:Name="ConfirmRuleLength" FontSize="12" TextColor="Red" />
                    <Label x:Name="ConfirmRuleUpper" FontSize="12" TextColor="Red" />
                    <Label x:Name="ConfirmRuleLower" FontSize="12" TextColor="Red" />
                    <Label x:Name="ConfirmRuleDigit" FontSize="12" TextColor="Red" />
                    <Label x:Name="ConfirmRuleSpecial" FontSize="12" TextColor="Red" />
                    <Label x:Name="ConfirmMismatchLabel" FontSize="12" TextColor="Red" />
                </StackLayout>
            </StackLayout>

            <!-- 提交按钮 -->
            <Button Text="Confirm"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="50"
                    Clicked="OnResetClicked" />

        </StackLayout>
    </ScrollView>
</ContentPage>
