<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CommunityFinder.Views.ResetPasswordPage"
    Title="Reset Password"
    BackgroundColor="#F9FFE3">

    <ScrollView>
        <StackLayout Padding="30" Spacing="20" VerticalOptions="Center">

            <!-- 顶部图标 -->
            <HorizontalStackLayout HorizontalOptions="End">
                <Frame HeightRequest="60" WidthRequest="60" CornerRadius="30"
                       BackgroundColor="#FFF59D" HasShadow="False"
                       HorizontalOptions="End" VerticalOptions="Start">
                    <Image Source="reset_icon.png" HeightRequest="36" WidthRequest="36"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Frame>
            </HorizontalStackLayout>

            <!-- 页面标题 -->
            <Label Text="Reset Password" FontSize="28" FontAttributes="Bold"
                   HorizontalOptions="Center" TextColor="#333" />

            <!-- 新密码 -->
            <StackLayout Spacing="4">
                <Label Text="Create new password*" FontSize="14" TextColor="#333" />
                <Grid ColumnDefinitions="*,Auto">
                    <Entry x:Name="PasswordEntry"
                           Placeholder="Please enter a new password"
                           PlaceholderColor="#000000"
                           IsPassword="True"
                           BackgroundColor="#F0F0F0"
                           HeightRequest="48"
                           FontSize="16"
                           TextChanged="OnPasswordTextChanged"
                           Grid.Column="0" />
                    <ImageButton Source="eye_icon.png"
                                 HeightRequest="24" WidthRequest="24"
                                 BackgroundColor="Transparent"
                                 Clicked="OnTogglePasswordClicked"
                                 Grid.Column="1" />
                </Grid>
                <Label x:Name="PasswordErrorLabel" TextColor="Red" FontSize="12" IsVisible="False" />
            </StackLayout>

            <!-- 确认密码 -->
            <StackLayout Spacing="4">
                <Label Text="Confirm Password*" FontSize="14" TextColor="#333" />
                <Entry x:Name="ConfirmEntry"
                       Placeholder="Please Enter"
                       PlaceholderColor="#000000"
                       IsPassword="True"
                       BackgroundColor="#F0F0F0"
                       HeightRequest="48"
                       FontSize="16"
                       TextChanged="OnConfirmPasswordTextChanged" />
                <Label x:Name="ConfirmErrorLabel" TextColor="Red" FontSize="12" IsVisible="False" />
            </StackLayout>

            <!-- 提交按钮 -->
            <Button Text="Confirm"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="50"
                    Clicked="OnResetClicked" />

        </StackLayout>
    </ScrollView>
</ContentPage>
