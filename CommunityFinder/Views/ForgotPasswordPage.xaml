<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CommunityFinder.Views.ForgotPasswordPage"
    Title="Forgot Password"
    BackgroundColor="#F9FFE3">

    <!-- 用 Grid 叠加布局 -->
    <Grid>
        <!-- 主体内容 -->
        <ScrollView>
            <StackLayout Padding="30" Spacing="25" VerticalOptions="Center">

                <!-- 页面标题 -->
                <Label Text="Forget Your Password"
                       FontSize="28"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="#333" />

                <!-- 副标题 -->
                <Label Text="Please enter your email:"
                       FontSize="16"
                       HorizontalOptions="Center"
                       TextColor="#666" />

                <!-- 邮箱输入框 -->
                <Entry
                    x:Name="EmailEntry"
                    Placeholder="Enter your email"
                    PlaceholderColor="#000000"
                    Keyboard="Email"
                    TextColor="#333"
                    BackgroundColor="#F9FFE3"
                    HeightRequest="50"
                    FontSize="16"
                    Margin="0,10" />

                <!-- 发送重置邮件按钮 -->
                <Button Text="Send Password Reset Email"
                        BackgroundColor="#5DB634"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="50"
                        Clicked="OnSendResetClicked" />

                <!-- 注册跳转 -->
                <Label Text="Sign Up"
                       TextColor="Red"
                       FontSize="14"
                       HorizontalOptions="End">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToSignUpCommand}" />
                    </Label.GestureRecognizers>
                </Label>

            </StackLayout>
        </ScrollView>

        <!-- 固定在右上角的新图片 -->
        <Image
            Source="icon1.png"
            HeightRequest="50"
            WidthRequest="50"
            HorizontalOptions="End"
            VerticalOptions="Start"
            Margin="10" />
    </Grid>
</ContentPage>
