<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CommunityFinder.Views.SignUpPage"
    Title="Sign Up"
    BackgroundColor="#F9FFE3">

    <Grid>
        <!-- 右上角图片 -->
        <Image
            Source="icon1.png"  
            WidthRequest="60"
            HeightRequest="60"
            HorizontalOptions="End"
            VerticalOptions="Start"
            Margin="10" />

            <!-- 页面内容 -->
            <ScrollView>
                <StackLayout Padding="30" Spacing="20" VerticalOptions="Center">

                    <!-- 页面标题 -->
                    <Label
                    Text="Sign Up"
                    FontSize="28"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    TextColor="#333" />

                    <!-- 用户名 -->
                    <Entry
                    x:Name="UsernameEntry"
                    Placeholder="Username"
                    PlaceholderColor="#000000"
                    BackgroundColor="#D9D9D9"
                    HeightRequest="48"
                    FontSize="16" />

                    <!-- 邮箱 + 验证按钮 -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Entry
                        x:Name="EmailEntry"
                        Placeholder="Email address"
                        PlaceholderColor="#000000"
                        Keyboard="Email"
                        BackgroundColor="#D9D9D9"
                        HeightRequest="48"
                        FontSize="16"
                        Grid.Column="0" />
                        <Button
                        Text="Verification"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        FontSize="14"
                        CornerRadius="6"
                        HeightRequest="48"
                        Grid.Column="1" />
                    </Grid>

                    <!-- 手机号 -->
                    <Entry
                    x:Name="PhoneEntry"
                    Placeholder="Mobile phone number"
                    PlaceholderColor="#000000"
                    Keyboard="Telephone"
                    BackgroundColor="#D9D9D9"
                    HeightRequest="48"
                    FontSize="16" />

                    <!-- 密码 -->
                    <Entry
                    x:Name="PasswordEntry"
                    Placeholder="Password"
                    PlaceholderColor="#000000"
                    IsPassword="True"
                    BackgroundColor="#D9D9D9"
                    HeightRequest="48"
                    FontSize="16" />

                    <!-- 确认密码 -->
                    <Entry
                    x:Name="ConfirmPasswordEntry"
                    Placeholder="Confirm Password"
                    PlaceholderColor="#000000"
                    IsPassword="True"
                    BackgroundColor="#D9D9D9"
                    HeightRequest="48"
                    FontSize="16" />

                    <!-- 提交按钮 -->
                    <Button
                    Text="Submit"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="50"
                    Clicked="OnSignUpClicked" />

                    <!-- 已有账号？去登录 -->
                    <Label
                    Text="Do you already have an account? Log in"
                    TextColor="#2196F3"
                    FontSize="14"
                    HorizontalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGoToLoginClicked" />
                        </Label.GestureRecognizers>
                    </Label>

                </StackLayout>
            </ScrollView>
    </Grid>
</ContentPage>

