<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CommunityFinder.Views.QuickLoginPage"
             Title="QuickLoginPage"
             BackgroundColor="#F9FFE3"
             >
    <StackLayout
    Padding="30"
    Spacing="20"
    VerticalOptions="Center">

        <Image
            Source="icon2.png"  
            WidthRequest="100"
            HeightRequest="100"
            HorizontalOptions="Center"
            Margin="0,0,0,10" />
        
        
        <Label
      Text="Welcome to use the quick login function"
      FontSize="Medium"
      HorizontalOptions="Center" />

        <Button
      x:Name="QuickLoginButton"
            BackgroundColor="#4CAF50"
      Text="Quick login"
      Clicked="OnQuickLoginClicked" />

        <Button
      x:Name="GoToNormalLoginButton"
            BackgroundColor="#4CAF50"
      Text="Return to normal login"
      Clicked="OnGoToNormalLoginClicked" />
    </StackLayout>
</ContentPage>