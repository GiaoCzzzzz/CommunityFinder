<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CommunityFinder.Views.ForumSearchResultsPage"
             Title="Search Results"
             BackgroundColor="#F9FFE3">

    <Grid RowDefinitions="Auto,*">
        <Frame Grid.Row="0"
               BackgroundColor="White"
               Padding="12"
               Margin="10"
               CornerRadius="10"
               HasShadow="True">
            <HorizontalStackLayout Spacing="10">
                <Label Text="Filter by category:"
                       VerticalOptions="Center"
                       FontAttributes="Bold"/>
                <Picker x:Name="CategoryFilterPicker"
                        HorizontalOptions="FillAndExpand"
                        SelectedIndexChanged="OnCategoryFilterChanged"/>
            </HorizontalStackLayout>
        </Frame>
        <CollectionView x:Name="ResultsCollection"
                        Grid.Row="1"
                        Margin="10"
                        SelectionMode="Single"
                        SelectionChanged="OnPostSelected">
            <CollectionView.EmptyView>
                <Label Text="No results found"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="Gray"
                       Margin="20"/>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,0,0,10" 
                           Padding="15" 
                           BackgroundColor="White"
                           CornerRadius="8"
                           HasShadow="True">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding Username}"
                                   FontSize="12"
                                   TextColor="Gray"/>
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding PostType}"
                                   FontSize="12"
                                   BackgroundColor="#4A90E2"
                                   TextColor="White"
                                   Padding="8,4"/>
                            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="{Binding CategoryName}"
                                   FontSize="12"
                                   TextColor="#2D4A82"
                                   Margin="0,6,0,0"/>
                            <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="{Binding Topic}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   Margin="0,10,0,5"/>
                            <Label Grid.Row="3" Grid.Column="0"
                                   FontSize="12"
                                   TextColor="Gray">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="💬 "/>
                                        <Span Text="{Binding ReplyCount}"/>
                                        <Span Text=" replies"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
