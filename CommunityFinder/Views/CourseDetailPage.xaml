<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="CommunityFinder.Views.CourseDetailPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Course Detail">

    <Grid RowDefinitions="Auto,*">

        <!-- 顶部横幅：图片 + 标题 + 课程码 + 名额 -->
        <Grid HeightRequest="250" BackgroundColor="#333">
            <Image Source="{Binding Detail.ImageUrl}" Aspect="AspectFill" Opacity="0.35">
                <Image.HeightRequest>
                    <OnPlatform x:TypeArguments="x:Double" Default="250" />
                </Image.HeightRequest>
            </Image>
            <VerticalStackLayout Padding="16,28,16,16" VerticalOptions="End" Spacing="6">
                <Label Text="{Binding Detail.Title}" FontAttributes="Bold" FontSize="22" TextColor="White"/>
                <HorizontalStackLayout Spacing="12">
                    <Label Text="{Binding Detail.CourseCode, StringFormat='Ref Code: {0}'}" TextColor="#EEEEEE"/>
                    <!-- 👤 名额（Booked/Max） -->
                    <Label Text="{Binding Detail.VacancyText, StringFormat='👤 {0}'}"
                           TextColor="#EEEEEE" IsVisible="{Binding Detail.VacancyText}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>

        <!-- 主体 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,160" Padding="16" ColumnSpacing="16">

            <!-- 左列：正文 -->
            <ScrollView Grid.Column="0">
                <VerticalStackLayout Spacing="18">
                    <HorizontalStackLayout Spacing="12" IsVisible="{Binding Detail.OrganizerName}">
                        <Label Text="{Binding Detail.OrganizerName}" TextColor="#EF6C00" FontAttributes="Bold"/>
                        <Label Text="{Binding Detail.Language}" TextColor="#666"/>
                    </HorizontalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding Detail.HasDescription}">
                        <Label Text="Course Description" FontSize="18" FontAttributes="Bold"/>
                        <Label Text="{Binding Detail.Description}" LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>

                    <!-- ✅ 合并展示 Requirements + Remarks -->
                    <VerticalStackLayout IsVisible="{Binding Detail.HasReqAndRemarks}">
                        <Label Text="Requirements and Remarks" FontSize="18" FontAttributes="Bold"/>
                        <Label Text="{Binding Detail.RequirementsAndRemarks}" LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding Detail.HasVenue}">
                        <Label Text="Venue" FontSize="18" FontAttributes="Bold"/>
                        <Label Text="{Binding Detail.Venue}" LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>

                    <!-- Trainers -->
                    <VerticalStackLayout IsVisible="{Binding Detail.HasTrainers}">
                        <Label Text="Training Provider(s)" FontSize="18" FontAttributes="Bold"/>
                        <CollectionView ItemsSource="{Binding Detail.Trainers}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="80,*" ColumnSpacing="12" Padding="0,8">
                                        <Image Source="{Binding PhotoUrl}" WidthRequest="80" HeightRequest="80" Aspect="AspectFill">
                                            <Image.Clip>
                                                <RoundRectangleGeometry CornerRadius="8" Rect="0,0,80,80"/>
                                            </Image.Clip>
                                        </Image>
                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                            <Label Text="{Binding Name}" FontAttributes="Bold"/>
                                            <Label Text="{Binding Bio}" LineBreakMode="WordWrap"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <Label Text="{Binding Error}" TextColor="#C62828" IsVisible="{Binding Error}" />
                </VerticalStackLayout>
            </ScrollView>

            <!-- 右列：日期/价格卡片（宽度缩小为 160） -->
            <Grid Grid.Column="1">
                <Frame Padding="16" CornerRadius="12" HasShadow="True" BackgroundColor="White">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Date &amp; Time" FontAttributes="Bold" FontSize="18"/>
                        <Label Text="{Binding Detail.StartDayText}" />
                        <Label Text="{Binding Detail.DateRangeText}" />
                        <Label Text="{Binding Detail.SessionsText}" />
                        <Label Text="{Binding Detail.RegistrationClosingDate, StringFormat='Registration Closing Date: {0}'}" />

                        <BoxView HeightRequest="1" BackgroundColor="#EEE" Margin="0,8"/>

                        <Label Text="Price" FontAttributes="Bold" FontSize="16"/>
                        <Label Text="{Binding Detail.PriceText}" />

                        <Button Text="Book now" BackgroundColor="#E53935" TextColor="White" CornerRadius="8" Margin="0,8,0,0"
                                Clicked="OnBookNowClicked"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- 局部加载遮罩（只盖住右侧卡片区域） -->
                <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#66000000" InputTransparent="False">
                    <ActivityIndicator IsRunning="True" IsVisible="True"
                             HorizontalOptions="Center" VerticalOptions="Center"
                             WidthRequest="40" HeightRequest="40"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
