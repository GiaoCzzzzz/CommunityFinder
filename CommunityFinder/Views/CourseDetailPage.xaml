<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="CommunityFinder.Views.CourseDetailPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:CommunityFinder.Converters"
             Title="Course Detail">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:LikeIconConverter x:Key="LikeIconConverter" />
            <converters:FavoriteIconConverter x:Key="FavoriteIconConverter" />
            <converters:LikeBorderColorConverter x:Key="LikeBorderColorConverter" />
            <converters:FavoriteBorderColorConverter x:Key="FavoriteBorderColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- 顶部横幅 -->
        <Grid HeightRequest="250" BackgroundColor="#333">
            <Image Source="{Binding Detail.ImageUrl}" Aspect="AspectFill" Opacity="0.35" />
            <VerticalStackLayout Padding="16,28,16,16" VerticalOptions="End" Spacing="6">
                <Label Text="{Binding Detail.Title}" FontAttributes="Bold" FontSize="22" TextColor="White"/>
                <HorizontalStackLayout Spacing="12">
                    <Label Text="{Binding Detail.CourseCode, StringFormat='Ref Code: {0}'}" TextColor="#EEEEEE"/>
                    <Label Text="{Binding Detail.VacancyText, StringFormat='👤 {0}'}"
                           TextColor="#EEEEEE" IsVisible="{Binding Detail.VacancyText}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>

        <!-- 主体 - 响应式布局 -->
        <ScrollView Grid.Row="1" x:Name="MainScrollView" IsVisible="True">
            <Grid Padding="16" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 小屏幕 - 卡片在上方 -->
                <Frame Grid.Row="0" Padding="12" CornerRadius="10" HasShadow="True" BackgroundColor="White">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Date &amp; Time" FontAttributes="Bold" FontSize="14"/>
                        <Label Text="{Binding Detail.StartDayText}" FontSize="12" LineBreakMode="WordWrap"/>
                        <Label Text="{Binding Detail.DateRangeText}" FontSize="12" LineBreakMode="WordWrap"/>
                        <Label Text="{Binding Detail.SessionsText}" FontSize="12" LineBreakMode="WordWrap"/>
                        <Label Text="{Binding Detail.RegistrationClosingDate, StringFormat='Closing: {0}'}" 
                               FontSize="11" TextColor="#666" LineBreakMode="WordWrap"/>

                        <BoxView HeightRequest="1" BackgroundColor="#EEE" Margin="0,6"/>

                        <Label Text="Price" FontAttributes="Bold" FontSize="13"/>
                        <Label Text="{Binding Detail.PriceText}" FontSize="12" Margin="0,0,0,6"/>

                        <Button Text="Book now"
                                BackgroundColor="#E53935"
                                TextColor="White"
                                CornerRadius="6"
                                FontSize="13"
                                HeightRequest="38"
                                Margin="0,0,0,12"
                                Clicked="OnBookNowClicked"/>

                        <!-- 点赞/收藏/注册统计 - 放在Book Now按钮下方 -->
                        <Grid ColumnDefinitions="*,*,*" HorizontalOptions="FillAndExpand" ColumnSpacing="8">
                            <!-- 点赞按钮 -->
                            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="4">
                                <Button Command="{Binding LikeCommand}"
                                        Text="{Binding IsLiked, Converter={StaticResource LikeIconConverter}}"
                                        BackgroundColor="Transparent"
                                        BorderColor="{Binding IsLiked, Converter={StaticResource LikeBorderColorConverter}}"
                                        BorderWidth="1.5"
                                        FontSize="14"
                                        CornerRadius="14"
                                        WidthRequest="28" HeightRequest="28"
                                        Padding="0"/>
                                <Label Text="{Binding LikeCount}" FontSize="11" HorizontalOptions="Center" FontAttributes="Bold"/>
                            </VerticalStackLayout>

                            <!-- 收藏按钮 -->
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                                <Button Command="{Binding FavoriteCommand}"
                                        Text="{Binding IsFavorited, Converter={StaticResource FavoriteIconConverter}}"
                                        BackgroundColor="Transparent"
                                        BorderColor="{Binding IsFavorited, Converter={StaticResource FavoriteBorderColorConverter}}"
                                        BorderWidth="1.5"
                                        FontSize="14"
                                        CornerRadius="14"
                                        WidthRequest="28" HeightRequest="28"
                                        Padding="0"/>
                                <Label Text="{Binding FavoriteCount}" FontSize="11" HorizontalOptions="Center" FontAttributes="Bold"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4" >
                                <Button Text="📝"
                                            BackgroundColor="Transparent"
                                            BorderColor="#DDD"
                                            BorderWidth="1.5"
                                            FontSize="16"
                                            CornerRadius="14"
                                            WidthRequest="28" HeightRequest="28"
                                            Padding="0"
                                            IsEnabled="False"
                                            FontAttributes="Bold"/>
                                <Label Text="{Binding RegisteredCount}" FontSize="11" HorizontalOptions="Center" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- 小屏幕 - 主要内容在下方 -->
                <VerticalStackLayout Grid.Row="2" Spacing="20">
                    <!-- 组织者与语言 -->
                    <HorizontalStackLayout Spacing="12" IsVisible="{Binding Detail.OrganizerName}">
                        <Label Text="{Binding Detail.OrganizerName}" TextColor="#EF6C00" FontAttributes="Bold" FontSize="16"/>
                        <Label Text="{Binding Detail.Language}" TextColor="#666" FontSize="14"/>
                    </HorizontalStackLayout>

                    <!-- 课程描述 -->
                    <VerticalStackLayout IsVisible="{Binding Detail.HasDescription}" Spacing="8">
                        <Label Text="Course Description" FontSize="20" FontAttributes="Bold"/>
                        <Label Text="{Binding Detail.Description}" LineBreakMode="WordWrap" FontSize="15"/>
                    </VerticalStackLayout>

                    <!-- 要求与备注 -->
                    <VerticalStackLayout IsVisible="{Binding Detail.HasReqAndRemarks}" Spacing="8">
                        <Label Text="Requirements and Remarks" FontSize="20" FontAttributes="Bold"/>
                        <Label Text="{Binding Detail.RequirementsAndRemarks}" LineBreakMode="WordWrap" FontSize="15"/>
                    </VerticalStackLayout>

                    <!-- 场地 -->
                    <VerticalStackLayout IsVisible="{Binding Detail.HasVenue}" Spacing="8">
                        <Label Text="Venue" FontSize="20" FontAttributes="Bold"/>
                        <Label Text="{Binding Detail.Venue}" LineBreakMode="WordWrap" FontSize="15"/>
                    </VerticalStackLayout>

                    <!-- 培训讲师 -->
                    <VerticalStackLayout IsVisible="{Binding Detail.HasTrainers}" Spacing="8">
                        <Label Text="Training Provider(s)" FontSize="20" FontAttributes="Bold"/>
                        <CollectionView ItemsSource="{Binding Detail.Trainers}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="80,*" ColumnSpacing="12" Padding="0,8">
                                        <Image Source="{Binding PhotoUrl}" WidthRequest="80" HeightRequest="80" Aspect="AspectFill">
                                            <Image.Clip>
                                                <RoundRectangleGeometry CornerRadius="8" Rect="0,0,80,80"/>
                                            </Image.Clip>
                                        </Image>
                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="15"/>
                                            <Label Text="{Binding Bio}" LineBreakMode="WordWrap" FontSize="14"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <Label Text="{Binding Error}" TextColor="#C62828" IsVisible="{Binding Error}" />
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <!-- 大屏幕版本 -->
        <ScrollView Grid.Row="1" x:Name="LargeScreenScrollView" IsVisible="False">
            <Grid Padding="16" ColumnSpacing="20" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- 左列 - 主要内容区 -->
                <VerticalStackLayout Grid.Column="0" Spacing="20">
                    <!-- 组织者与语言 -->
                    <HorizontalStackLayout Spacing="12" IsVisible="{Binding Detail.OrganizerName}">
                        <Label Text="{Binding Detail.OrganizerName}" TextColor="#EF6C00" FontAttributes="Bold" FontSize="16"/>
                        <Label Text="{Binding Detail.Language}" TextColor="#666" FontSize="14"/>
                    </HorizontalStackLayout>

                    <!-- 课程描述 -->
                    <VerticalStackLayout IsVisible="{Binding Detail.HasDescription}" Spacing="8">
                        <Label Text="Course Description" FontSize="20" FontAttributes="Bold"/>
                        <Label Text="{Binding Detail.Description}" LineBreakMode="WordWrap" FontSize="15"/>
                    </VerticalStackLayout>

                    <!-- 要求与备注 -->
                    <VerticalStackLayout IsVisible="{Binding Detail.HasReqAndRemarks}" Spacing="8">
                        <Label Text="Requirements and Remarks" FontSize="20" FontAttributes="Bold"/>
                        <Label Text="{Binding Detail.RequirementsAndRemarks}" LineBreakMode="WordWrap" FontSize="15"/>
                    </VerticalStackLayout>

                    <!-- 场地 -->
                    <VerticalStackLayout IsVisible="{Binding Detail.HasVenue}" Spacing="8">
                        <Label Text="Venue" FontSize="20" FontAttributes="Bold"/>
                        <Label Text="{Binding Detail.Venue}" LineBreakMode="WordWrap" FontSize="15"/>
                    </VerticalStackLayout>

                    <!-- 培训讲师 -->
                    <VerticalStackLayout IsVisible="{Binding Detail.HasTrainers}" Spacing="8">
                        <Label Text="Training Provider(s)" FontSize="20" FontAttributes="Bold"/>
                        <CollectionView ItemsSource="{Binding Detail.Trainers}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="80,*" ColumnSpacing="12" Padding="0,8">
                                        <Image Source="{Binding PhotoUrl}" WidthRequest="80" HeightRequest="80" Aspect="AspectFill">
                                            <Image.Clip>
                                                <RoundRectangleGeometry CornerRadius="8" Rect="0,0,80,80"/>
                                            </Image.Clip>
                                        </Image>
                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="15"/>
                                            <Label Text="{Binding Bio}" LineBreakMode="WordWrap" FontSize="14"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <Label Text="{Binding Error}" TextColor="#C62828" IsVisible="{Binding Error}" />
                </VerticalStackLayout>

                <!-- 右列 - 侧边操作区 -->
                <Grid Grid.Column="1">
                    <VerticalStackLayout Spacing="10" VerticalOptions="Start">
                        <!-- 日期与价格卡片 -->
                        <Frame Padding="12" CornerRadius="10" HasShadow="True" BackgroundColor="White">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Date &amp; Time" FontAttributes="Bold" FontSize="14"/>
                                <Label Text="{Binding Detail.StartDayText}" FontSize="12" LineBreakMode="WordWrap"/>
                                <Label Text="{Binding Detail.DateRangeText}" FontSize="12" LineBreakMode="WordWrap"/>
                                <Label Text="{Binding Detail.SessionsText}" FontSize="12" LineBreakMode="WordWrap"/>
                                <Label Text="{Binding Detail.RegistrationClosingDate, StringFormat='Closing: {0}'}" 
                                       FontSize="11" TextColor="#666" LineBreakMode="WordWrap"/>

                                <BoxView HeightRequest="1" BackgroundColor="#EEE" Margin="0,6"/>

                                <Label Text="Price" FontAttributes="Bold" FontSize="13"/>
                                <Label Text="{Binding Detail.PriceText}" FontSize="12" Margin="0,0,0,6"/>

                                <Button Text="Book now"
                                        BackgroundColor="#E53935"
                                        TextColor="White"
                                        CornerRadius="6"
                                        FontSize="13"
                                        HeightRequest="38"
                                        Margin="0,0,0,12"
                                        Clicked="OnBookNowClicked"/>

                                <!-- 点赞/收藏/注册统计 -->
                                <Grid ColumnDefinitions="*,*,*" HorizontalOptions="FillAndExpand" ColumnSpacing="8">
                                    <!-- 点赞按钮 -->
                                    <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="4">
                                        <Button Command="{Binding LikeCommand}"
                                                Text="{Binding IsLiked, Converter={StaticResource LikeIconConverter}}"
                                                BackgroundColor="Transparent"
                                                BorderColor="{Binding IsLiked, Converter={StaticResource LikeBorderColorConverter}}"
                                                BorderWidth="1.5"
                                                FontSize="14"
                                                CornerRadius="14"
                                                WidthRequest="28" HeightRequest="28"
                                                Padding="0"/>
                                        <Label Text="{Binding LikeCount}" FontSize="11" HorizontalOptions="Center" FontAttributes="Bold"/>
                                    </VerticalStackLayout>

                                    <!-- 收藏按钮 -->
                                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                                        <Button Command="{Binding FavoriteCommand}"
                                                Text="{Binding IsFavorited, Converter={StaticResource FavoriteIconConverter}}"
                                                BackgroundColor="Transparent"
                                                BorderColor="{Binding IsFavorited, Converter={StaticResource FavoriteBorderColorConverter}}"
                                                BorderWidth="1.5"
                                                FontSize="14"
                                                CornerRadius="14"
                                                WidthRequest="28" HeightRequest="28"
                                                Padding="0"/>
                                        <Label Text="{Binding FavoriteCount}" FontSize="11" HorizontalOptions="Center" FontAttributes="Bold"/>
                                    </VerticalStackLayout>

                                    <!-- 注册数量 - 与点赞收藏平行 -->
                                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4" >
                                        <Button Text="📝"
                                            BackgroundColor="Transparent"
                                            BorderColor="#DDD"
                                            BorderWidth="1.5"
                                            FontSize="16"
                                            CornerRadius="14"
                                            WidthRequest="28" HeightRequest="28"
                                            Padding="0"
                                            IsEnabled="False"
                                            FontAttributes="Bold"/>
                                        <Label Text="{Binding RegisteredCount}" FontSize="11" HorizontalOptions="Center" FontAttributes="Bold"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>
                </Grid>
            </Grid>
        </ScrollView>

        <!-- 加载遮罩 -->
        <Grid Grid.Row="1" x:Name="LoadingOverlay" IsVisible="{Binding IsBusy}" BackgroundColor="#66000000" InputTransparent="False" ZIndex="999">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               WidthRequest="40" HeightRequest="40"/>
        </Grid>
    </Grid>
</ContentPage>