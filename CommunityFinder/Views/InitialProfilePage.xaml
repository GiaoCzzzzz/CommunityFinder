<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CommunityFinder.Views.InitialProfilePage"
             Title="InitialProfilePage"
             BackgroundColor="#F9FFE3">
 
    <ScrollView>
        <StackLayout Padding="20" Spacing="15">
            <Entry x:Name="GenderEnrty"        Placeholder="Gender" PlaceholderColor="#000000" />
            <Editor x:Name="ageEnrty"        Placeholder="Age" HeightRequest="100"  PlaceholderColor="#000000"/>
            <Editor x:Name="postcodeEnrty"        Placeholder="Post Office" HeightRequest="100"  PlaceholderColor="#000000"/>
            <Editor x:Name="occupationEnrty"        Placeholder="Occupation" HeightRequest="100"  PlaceholderColor="#000000"/>
            <Editor x:Name="nationalityEnrty"        Placeholder="Nationality" HeightRequest="100" PlaceholderColor="#000000" />
            <Editor x:Name="interestEnrty"        Placeholder="Hobby" HeightRequest="100"  PlaceholderColor="#000000"/>

            <Button Text="Save" Clicked="OnSaveClicked" />
        </StackLayout>
    </ScrollView>
</ContentPage>